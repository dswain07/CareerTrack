
@model CareerTrack.Data.Models.JobApplication

@{
    ViewData["Title"] = "Delete Job Application";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="mb-1">Delete Job Application</h1>

    <p class="text-body-secondary mb-0">
        Review the application details before confirming deletion.
    </p>
</div>

<!-- Deletion Warning -->
<div class="alert alert-danger" role="alert">
    <h5 class="alert-heading">Confirm Deletion</h5>

    <p class="mb-2">
        Are you sure you want to permanently delete this job application?
    </p>

    <p class="mb-0">
        <strong>Warning:</strong>
        Any interviews associated with this application may also
        be permanently deleted because of the database's
        cascade-delete relationship.
    </p>
</div>

<!-- Application Information -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-body">
        <h5 class="mb-0">@Model.JobTitle</h5>
    </div>

    <div class="card-body p-4">

        <dl class="row mb-0">

            <dt class="col-sm-3 mb-3">Job Title</dt>
            <dd class="col-sm-9 mb-3">
                @Model.JobTitle
            </dd>

            <dt class="col-sm-3 mb-3">Company</dt>
            <dd class="col-sm-9 mb-3">
                @(Model.Company?.Name ?? "—")
            </dd>

            <dt class="col-sm-3 mb-3">Application Status</dt>
            <dd class="col-sm-9 mb-3">
                @(Model.ApplicationStatus?.Name ?? "—")
            </dd>

            <dt class="col-sm-3 mb-3">Date Applied</dt>
            <dd class="col-sm-9 mb-3">
                @Model.DateApplied.ToString("MMMM dd, yyyy")
            </dd>

            <dt class="col-sm-3 mb-3">Location</dt>
            <dd class="col-sm-9 mb-3">
                @(Model.Location ?? "—")
            </dd>

            <dt class="col-sm-3 mb-3">Salary</dt>
            <dd class="col-sm-9 mb-3">
                @if (Model.Salary.HasValue)
                {
                    @Model.Salary.Value.ToString("C0")
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

            <dt class="col-sm-3 mb-3">Job URL</dt>
            <dd class="col-sm-9 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.JobUrl))
                {
                    <a href="@Model.JobUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        View Job Posting
                    </a>
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

            <dt class="col-sm-3 mb-3">Notes</dt>
            <dd class="col-sm-9 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <span style="white-space: pre-wrap;">@Model.Notes</span>
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

        </dl>

        <hr class="my-4" />

        <!-- Confirmation Form -->
        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit" class="btn btn-danger">
                    Delete Application
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>
