
@model IEnumerable<CareerTrack.Data.Models.Interview>

@{
    ViewData["Title"] = "Interviews";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Interviews</h1>
        <p class="text-body-secondary mb-0">
            Track upcoming interviews and review your interview history.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Interview
    </a>
</div>

<!-- Interviews Table -->
<div class="card shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">Interview Records</h5>

            <span class="badge text-bg-secondary">
                @Model.Count() Interviews
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Interview Type</th>
                        <th>Interview Date</th>
                        <th>Location</th>
                        <th>Outcome</th>
                        <th>Notes</th>
                        <th>Job Application</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @item.InterviewType
                            </td>

                            <td>
                                @item.InterviewDate.ToString("MMM dd, yyyy h:mm tt")
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Location))
                                {
                                    @item.Location
                                }
                                else
                                {
                                    <span class="text-body-secondary">—</span>
                                }
                            </td>

                            <td>
                                @{
                                    var outcome = item.Outcome ?? "Unknown";

                                    var outcomeClass = outcome switch
                                    {
                                        "Passed" => "text-bg-success",
                                        "Pending" => "text-bg-warning",
                                        "Failed" => "text-bg-danger",
                                        "Cancelled" => "text-bg-secondary",
                                        _ => "text-bg-secondary"
                                    };
                                }

                                <span class="badge @outcomeClass">
                                    @outcome
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="d-inline-block text-truncate"
                                          style="max-width: 180px;"
                                          title="@item.Notes">
                                        @item.Notes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">—</span>
                                }
                            </td>

                            <td>
                                @if (item.JobApplication != null)
                                {
                                    <a asp-controller="JobApplications"
                                       asp-action="Details"
                                       asp-route-id="@item.JobApplicationId"
                                       class="text-decoration-none">
                                        @item.JobApplication.JobTitle
                                    </a>
                                }
                                else
                                {
                                    <span class="text-body-secondary">
                                        —
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex gap-1">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-body-secondary mb-0">
                    No interviews found.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary mt-2">
                    Add Your First Interview
                </a>
            </div>
        }

    </div>
</div>
