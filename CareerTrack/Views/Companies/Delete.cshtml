
@model CareerTrack.Data.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="mb-1">Delete Company</h1>

    <p class="text-body-secondary mb-0">
        Review the company information before confirming deletion.
    </p>
</div>

<!-- Deletion Warning -->
<div class="alert alert-danger" role="alert">
    <h5 class="alert-heading">Confirm Deletion</h5>

    <p>
        Are you sure you want to permanently delete
        <strong>@Model.Name</strong>?
    </p>

    <p class="mb-0">
        <strong>Warning:</strong>
        Deleting this company can also permanently delete
        its associated job applications, contacts, and
        interviews because of cascading database relationships.
        This action cannot be undone.
    </p>
</div>

<!-- Company Details -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-body">
        <h5 class="mb-0">@Model.Name</h5>
    </div>

    <div class="card-body p-4">

        <dl class="row mb-0">

            <!-- Company Name -->
            <dt class="col-sm-3 mb-3">
                Company Name
            </dt>
            <dd class="col-sm-9 mb-3">
                @Model.Name
            </dd>

            <!-- Industry -->
            <dt class="col-sm-3 mb-3">
                Industry
            </dt>
            <dd class="col-sm-9 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.Industry))
                {
                    @Model.Industry
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

            <!-- Location -->
            <dt class="col-sm-3 mb-3">
                Location
            </dt>
            <dd class="col-sm-9 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.Location))
                {
                    @Model.Location
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

            <!-- Website -->
            <dt class="col-sm-3 mb-3">
                Website
            </dt>
            <dd class="col-sm-9 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.Website))
                {
                    <a href="@Model.Website"
                       target="_blank"
                       rel="noopener noreferrer">
                        Visit Company Website
                    </a>
                }
                else
                {
                    <span class="text-body-secondary">—</span>
                }
            </dd>

        </dl>

        <hr class="my-4" />

        <!-- Delete Confirmation Form -->
        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit" class="btn btn-danger">
                    Delete Company
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>
