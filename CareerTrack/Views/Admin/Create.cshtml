@model CareerTrack.Data.Models.ApplicationStatus

@{
    ViewData["Title"] = "Create Application Status";
}

<h1>Create Application Status</h1>

<p class="text-muted">
    Add a new application status to CareerTrack.
</p>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Admin" asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create Status
            </button>

            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
