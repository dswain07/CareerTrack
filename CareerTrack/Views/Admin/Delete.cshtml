
@model CareerTrack.Data.Models.ApplicationStatus

@{
    ViewData["Title"] = "Delete Application Status";
}

<h1>Delete Application Status</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this application status?
</div>

<dl class="row">
    <dt class="col-sm-3">Status Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-controller="Admin"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

